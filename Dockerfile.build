# Multi-stage Dockerfile for building confcli binaries for multiple platforms
# Build from the root directory of the project: docker build -f Dockerfile.build -t confcli-builder .

# Build stage
FROM golang:1.25-alpine AS builder

# Install git (needed for go modules)
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Copy go mod files
COPY confcli-bin/go.mod go.mod
COPY confcli-bin/go.sum go.sum

# Download dependencies
RUN go mod download

# Copy source code
COPY confcli-bin/ .

# Create output directories for each platform/architecture
RUN mkdir -p /dist/linux/amd64 && \
    mkdir -p /dist/linux/arm64 && \
    mkdir -p /dist/windows/amd64 && \
    mkdir -p /dist/windows/arm64 && \
    mkdir -p /dist/darwin/amd64 && \
    mkdir -p /dist/darwin/arm64

# Build for Linux amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /dist/linux/amd64/confcli ./cmd/confcli

# Build for Linux arm64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /dist/linux/arm64/confcli ./cmd/confcli

# Build for Windows amd64
RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -o /dist/windows/amd64/confcli.exe ./cmd/confcli

# Build for Windows arm64
RUN CGO_ENABLED=0 GOOS=windows GOARCH=arm64 go build -o /dist/windows/arm64/confcli.exe ./cmd/confcli

# Build for macOS amd64
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -o /dist/darwin/amd64/confcli ./cmd/confcli

# Build for macOS arm64
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -o /dist/darwin/arm64/confcli ./cmd/confcli

# Final stage - create a minimal image with just the binaries
FROM alpine:latest

# Install zip utility for packaging
RUN apk --no-cache add zip

WORKDIR /dist

# Copy all built binaries from the builder stage (preserving directory structure)
COPY --from=builder /dist/linux/amd64/confcli ./linux/amd64/confcli
COPY --from=builder /dist/linux/arm64/confcli ./linux/arm64/confcli
COPY --from=builder /dist/windows/amd64/confcli.exe ./windows/amd64/confcli.exe
COPY --from=builder /dist/windows/arm64/confcli.exe ./windows/arm64/confcli.exe
COPY --from=builder /dist/darwin/amd64/confcli ./darwin/amd64/confcli
COPY --from=builder /dist/darwin/arm64/confcli ./darwin/arm64/confcli

# Create ZIP archives for each platform
RUN zip linux/amd64.zip linux/amd64/confcli && \
    zip linux/arm64.zip linux/arm64/confcli && \
    zip windows/amd64.zip windows/amd64/confcli.exe && \
    zip windows/arm64.zip windows/arm64/confcli.exe && \
    zip darwin/amd64.zip darwin/amd64/confcli && \
    zip darwin/arm64.zip darwin/arm64/confcli

# Set the default command to keep the container running so we can copy the binaries
CMD ["sh"]
